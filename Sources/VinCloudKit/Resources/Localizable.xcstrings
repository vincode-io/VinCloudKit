        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internal Error: a non-recoverable error was encountered by CloudKit."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internal Error: a non-recoverable error was encountered by CloudKit."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internal Error: a non-recoverable error was encountered by CloudKit."
          }
        },
        "ja" : {
