        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无效的容器：指定的容器未知或未获授权。"
          }
        }
      }
    },
    "error.text.bad-database" : {
      "comment" : "Error Message: Bad Database: the operation could not be completed on the given database.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ungültige Datenbank: Der Vorgang konnte in der angegebenen Datenbank nicht abgeschlossen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
