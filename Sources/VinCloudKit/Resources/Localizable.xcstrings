          "stringUnit" : {
            "state" : "translated",
            "value" : "Bad Container: the specified container is unknown or unauthorised."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "無効なコンテナ：指定されたコンテナが不明であるか、承認されていません。"
          }
