{
  "sourceLanguage" : "en",
  "strings" : {
    "error.text.account-temporarily-unavailable" : {
      "comment" : "Error Message: The iCloud Account is temporarily unavailable.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das iCloud-Konto ist vorübergehend nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iCloud Account is temporarily unavailable."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iCloud Account is temporarily unavailable."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iCloud Account is temporarily unavailable."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud アカウントは一時的に利用できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "iCloud 账户暂时不可用。"
          }
        }
      }
    },
    "error.text.already-shared" : {
      "comment" : "Error Message: Already Shared: a record or share cannot be saved because doing so would cause the same hierarchy of records to exist in multiple shares.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Datensatz oder eine Freigabe kann nicht gespeichert werden, da dies dazu führen würde, dass dieselbe Hierarchie von Datensätzen in mehreren Freigaben existiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A record or share cannot be saved because doing so would cause the same hierarchy of records to exist in multiple shares."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A record or share cannot be saved because doing so would cause the same hierarchy of records to exist in multiple shares."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A record or share cannot be saved because doing so would cause the same hierarchy of records to exist in multiple shares."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "レコードまたは共有を保存できません。保存すると、同じレコード階層が複数の共有に存在することになるためです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "无法保存记录或共享，因为这样做会导致同一记录层级存在于多个共享中。"
          }
        }
      }
    },
    "error.text.asset-file-modified" : {
      "comment" : "Error Message: Asset File Modified: the content of the specified asset file was modified while being saved.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asset-Datei verändert: Der Inhalt der angegebenen Asset-Datei wurde während des Speicherns verändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asset File Modified: the content of the specified asset file was modified while being saved."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asset File Modified: the content of the specified asset file was modified while being saved."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asset File Modified: the content of the specified asset file was modified while being saved."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "アセットファイルが変更されました：指定されたアセットファイルの内容が保存中に変更されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "资源文件已修改：指定资源文件的内容在保存过程中被修改。"
          }
        }
      }
    },
