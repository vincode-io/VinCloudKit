            "value" : "无效的数据库：无法在给定的数据库上完成该操作。"
          }
        }
      }
    },
    "error.text.batch-request-failed" : {
      "comment" : "Error Message: Batch Request Failed: the entire batch was rejected.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stapel-Anfrage fehlgeschlagen: Der gesamte Stapel wurde abgelehnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batch Request Failed: the entire batch was rejected."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batch Request Failed: the entire batch was rejected."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batch Request Failed: the entire batch was rejected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "バッチリクエストが失敗しました：バッチ全体が拒否されました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "批量请求失败：整个批次已被拒绝。"
          }
        }
      }
    },
    "error.text.change-token-expired" : {
      "comment" : "Error Message: Change Token Expired: the previous server change token is too old.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungs-Token abgelaufen: Das vorherige Server-Änderungs-Token ist zu alt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change Token Expired: the previous server change token is too old."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change Token Expired: the previous server change token is too old."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Change Token Expired: the previous server change token is too old."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "変更トークンの有効期限が切れました：以前のサーバー変更トークンが古すぎます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "更改令牌已过期：先前的服务器更改令牌过旧。"
          }
        }
      }
    },
    "error.text.constraint-violation" : {
      "comment" : "Error Message: Constraint Violation: the server rejected the request because of a conflict with a unique field.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einschränkungsverletzung: Der Server hat die Anfrage aufgrund eines Konflikts mit einem eindeutigen Feld abgelehnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Constraint Violation: the server rejected the request because of a conflict with a unique field."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Constraint Violation: the server rejected the request because of a conflict with a unique field."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Constraint Violation: the server rejected the request because of a conflict with a unique field."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "制約違反：一意フィールドとの競合により、サーバーがリクエストを拒否しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "违反约束：由于与唯一字段发生冲突，服务器拒绝了该请求。"
          }
        }
      }
    },
    "error.text.corrupt-account" : {
      "comment" : "Error Message: There is an unrecoverable problem with your application iCloud account. Please make sure you have iCloud and iCloud Drive enabled in System Preferences. Then remove the application iCloud account and add it again.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt ein nicht behebbares Problem mit Ihrem iCloud-Konto der Anwendung. Stellen Sie sicher, dass iCloud und iCloud Drive in den Systemeinstellungen aktiviert sind. Entfernen Sie dann das iCloud-Konto der Anwendung und fügen Sie es erneut hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is an unrecoverable problem with your application iCloud account. Please make sure you have iCloud and iCloud Drive enabled in System Preferences. Then remove the application iCloud account and add it again."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is an unrecoverable problem with your application iCloud account. Please make sure you have iCloud and iCloud Drive enabled in System Preferences. Then remove the application iCloud account and add it again."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is an unrecoverable problem with your application iCloud account. Please make sure you have iCloud and iCloud Drive enabled in System Preferences. Then remove the application iCloud account and add it again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "アプリの iCloud アカウントに回復不能な問題があります。システム設定で iCloud と iCloud Drive が有効になっていることを確認してください。その後、アプリの iCloud アカウントを削除し、もう一度追加してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "您用于本应用的 iCloud 账户出现了无法恢复的问题。请确保已在系统设置中启用 iCloud 和 iCloud Drive。然后移除本应用的 iCloud 账户并重新添加。"
          }
        }
      }
    },
    "error.text.incompatible-version" : {
      "comment" : "Error Message: Incompatible Version: your app version is older than the oldest version allowed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkompatible Version: Ihre App-Version ist älter als die älteste zulässige Version."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incompatible Version: your app version is older than the oldest version allowed."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incompatible Version: your app version is older than the oldest version allowed."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incompatible Version: your app version is older than the oldest version allowed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "互換性のないバージョン：お使いのアプリのバージョンが、許可されている最も古いバージョンよりも前のものです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "版本不兼容：您的应用版本早于所允许的最低版本。"
          }
        }
      }
    },
    "error.text.internal-error" : {
      "comment" : "Error Message: Internal Error: a nonrecoverable error was encountered by CloudKit.",
      "localizations" : {
